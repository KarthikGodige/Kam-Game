{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Play Revenge Game (Node Server)",
      "program": "${workspaceFolder}/server.js",
      "console": "integratedTerminal"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch in Chrome",
      "file": "${workspaceFolder}/index.html"
    },
    {
      "type": "msedge",
      "request": "launch",
      "name": "Launch in Edge",
      "file": "${workspaceFolder}/index.html"
    }
  ]
}
